<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_attendance" model="ir.ui.view">
        <field name="name">res.users.form.inherit.attendance</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Asistencia UNEFA" name="attendance">
                    <group>
                        <group string="Rol y Perfil Docente">
                            <field name="attendance_role"/>
                            <field name="teacher_category"/>
                            <field name="teacher_dedication"/>
                        </group>
                        <group string="Acceso al Sistema">
                            <field name="attendance_pin" password="True" placeholder="PIN de 4 dígitos"/>
                            <field name="attendance_device_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Estado de Seguridad" col="2">
                        <field name="failed_login_attempts" readonly="1"/>
                        <field name="lockout_until" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
