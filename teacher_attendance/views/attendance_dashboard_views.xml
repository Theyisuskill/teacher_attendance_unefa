<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acciones de cliente existentes -->
    <record id="action_attendance_dashboard" model="ir.actions.client">
        <field name="name">Attendance Dashboard</field>
        <field name="tag">attendance_scanner_action</field>
    </record>

    <record id="action_occupancy_map" model="ir.actions.client">
        <field name="name">Occupancy Map</field>
        <field name="tag">attendance_occupancy_map</field>
    </record>

    <record id="action_attendance_kiosk" model="ir.actions.client">
        <field name="name">Kiosk Mode</field>
        <field name="tag">attendance_kiosk_action</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- Nuevas acciones de cliente para gestión Owl -->
    <record id="action_user_manager" model="ir.actions.client">
        <field name="name">Gestión de Usuarios</field>
        <field name="tag">action_user_manager</field>
    </record>

    <record id="action_classroom_manager" model="ir.actions.client">
        <field name="name">Gestión de Aulas</field>
        <field name="tag">action_classroom_manager</field>
    </record>

    <record id="action_subject_manager" model="ir.actions.client">
        <field name="name">Gestión de Materias</field>
        <field name="tag">action_subject_manager</field>
    </record>

    <record id="action_substitution_manager" model="ir.actions.client">
        <field name="name">Gestión de Suplencias</field>
        <field name="tag">action_substitution_manager</field>
    </record>

    <record id="action_attendance_config" model="ir.actions.client">
        <field name="name">Configuración de Asistencia</field>
        <field name="tag">action_attendance_config</field>
    </record>

    <record id="action_contingency_manager" model="ir.actions.client">
        <field name="name">Contingencia Manual</field>
        <field name="tag">action_contingency_manager</field>
    </record>

    <record id="action_schedule_manager" model="ir.actions.client">
        <field name="name">Carga Horaria</field>
        <field name="tag">action_schedule_manager</field>
    </record>

    <record id="action_executed_hours" model="ir.actions.client">
        <field name="name">Horas Ejecutadas</field>
        <field name="tag">action_executed_hours</field>
    </record>

    <record id="action_justification_manager" model="ir.actions.client">
        <field name="name">Justificación de Asistencias</field>
        <field name="tag">action_justification_manager</field>
    </record>

    <record id="action_temp_block_manager" model="ir.actions.client">
        <field name="name">Bloques de Actividad Temporal</field>
        <field name="tag">action_temp_block_manager</field>
    </record>

    <record id="action_calendar_manager" model="ir.actions.client">
        <field name="name">Calendario Institucional</field>
        <field name="tag">action_calendar_manager</field>
    </record>

    <record id="action_report_generator" model="ir.actions.client">
        <field name="name">Generador de Reportes</field>
        <field name="tag">action_report_generator</field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_attendance_dashboard"
              name="Scan QR"
              parent="menu_teacher_attendance_root"
              action="action_attendance_dashboard"
              sequence="5"/>

    <menuitem id="menu_attendance_kiosk"
              name="Kiosk Mode"
              parent="menu_teacher_attendance_root"
              action="action_attendance_kiosk"
              sequence="7"/>

    <menuitem id="menu_occupancy_map"
              name="Occupancy Map"
              parent="menu_teacher_attendance_root"
              action="action_occupancy_map"
              sequence="8"/>
</odoo>
