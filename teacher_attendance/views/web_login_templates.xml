<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════
         LOGIN LAYOUT — hereda web.login_layout
         Split-screen: panel izquierdo (navy) + panel derecho (blanco)
         ══════════════════════════════════════════════════════════ -->
    <template id="login_layout_unefa" inherit_id="web.login_layout" name="UNEFA Login Layout">

        <!-- Inyectar fuentes de Google Fonts -->
        <xpath expr="//t[@t-call='web.frontend_layout']" position="inside">
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;family=Outfit:wght@400;500;600;700;800;900&amp;display=swap"/>
        </xpath>

        <!-- Inyectar cintillo obligatorio gubernamental (Conatel/Ministerio) -->
        <xpath expr="//div[hasclass('container')]" position="before">
            <div class="unefa-cintillo">
                <img src="/teacher_attendance/static/src/img/gob1-2023.jpg" alt="Gobierno Bolivariano de Venezuela" class="uc-banner-img"/>
            </div>
        </xpath>

        <!-- ① Quitar max-width 300px de Odoo, añadir clase unefa-login-card -->
        <xpath expr="//div[hasclass('container')]/div" position="attributes">
            <attribute name="style"></attribute>
            <attribute name="t-attf-class">card border-0 o_database_list unefa-login-card</attribute>
        </xpath>

        <!-- ② card-body sin padding -->
        <xpath expr="//div[hasclass('container')]/div/div[hasclass('card-body')]" position="attributes">
            <attribute name="style">padding:0;</attribute>
        </xpath>

        <!-- ③ Panel izquierdo de marca (reemplaza logo genérico de Odoo) -->
        <xpath expr="//div[hasclass('text-center')][img]" position="replace">
            <div class="unefa-left-panel">
                <!-- Orbes decorativos de fondo (efecto depth) -->
                <div class="ulp-orb ulp-orb-1"></div>
                <div class="ulp-orb ulp-orb-2"></div>
                <div class="ulp-orb ulp-orb-3"></div>

                <!-- Contenido central de marca -->
                <div class="ulp-brand">
                    <!-- Logo con ring blanco — tamaños forzados inline para garantía -->
                    <div class="ulp-logo-ring" style="width:96px;height:96px;min-width:96px;min-height:96px;overflow:hidden;border-radius:50%;background:#ffffff;display:flex;align-items:center;justify-content:center;padding:12px;box-sizing:border-box;margin:0 auto 20px;box-shadow:0 8px 28px rgba(0,0,0,0.15);">
                        <img src="/teacher_attendance/static/src/img/unefa_escudo.svg"
                             alt="Escudo UNEFA"
                             style="width:72px;height:72px;min-width:72px;min-height:72px;max-width:72px;max-height:72px;object-fit:contain;display:block;flex-shrink:0;"/>
                    </div>

                    <!-- Nombre completo de la universidad (Primero) -->
                    <p class="ulp-fullname">
                        Universidad Nacional Experimental Politécnica<br/>
                        de la Fuerza Armada Nacional Bolivariana
                    </p>

                    <!-- Siglas (Segundo) -->
                    <h1 class="ulp-name">UNEFA</h1>

                    <!-- Divisor tricolor corto -->
                    <div class="ulp-tricolor-sm">
                        <span></span><span></span><span></span>
                    </div>

                    <!-- Nombre del Sistema más grande -->
                    <h2 class="ulp-system-name">Control de Asistencia Docente</h2>
                </div>

                <!-- Franja tricolor en la base del panel -->
                <div class="ulp-tricolor-bottom">
                    <span></span><span></span><span></span>
                </div>
            </div>
        </xpath>

        <!-- ④ Footer del panel derecho (reemplaza "Powered by Odoo") -->
        <xpath expr="//div[hasclass('text-center')][a]" position="replace">
            <div class="unefa-right-footer">
                <span>© 2026 UNEFA · Excelencia Educativa Abierta al Pueblo</span>
            </div>
        </xpath>

    </template>


    <!-- ══════════════════════════════════════════════════════════
         LOGIN FORM — hereda web.login
         ══════════════════════════════════════════════════════════ -->
    <template id="login_form_unefa" inherit_id="web.login" name="UNEFA Login Form">

        <!-- Oculta enlace de registro (uso institucional cerrado) -->
        <xpath expr="//a[@t-if='signup_enabled']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Bloque de bienvenida antes del primer campo -->
        <xpath expr="//div[hasclass('field-login')]" position="before">
            <div class="unefa-welcome">
                <h2 class="unefa-welcome-title">¡Bienvenido!</h2>
                <p class="unefa-welcome-sub">Ingrese sus credenciales institucionales para continuar.</p>
            </div>
        </xpath>

    </template>
</odoo>
