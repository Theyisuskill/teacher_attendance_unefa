<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════ KANBAN VIEW ═══════ -->
    <record id="view_attendance_log_kanban" model="ir.ui.view">
        <field name="name">attendance.log.kanban</field>
        <field name="model">attendance.log</field>
        <field name="arch" type="xml">
            <kanban class="attendance_kanban o_unefa_view" create="false" default_order="check_in desc">
                <field name="id"/>
                <field name="teacher_id"/>
                <field name="classroom_id"/>
                <field name="subject_id"/>
                <field name="activity_type"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration"/>
                <field name="distance"/>
                <field name="status"/>
                <field name="is_substitution"/>
                <field name="signature"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <templates>
                    <t t-name="card">
                        <div class="attendance_kanban_card">
                            <!-- Status bar -->
                            <div class="attendance_kanban_card_status-bar"
                                 t-att-class="'status-' + record.status.raw_value"/>

                            <div class="attendance_kanban_card_body">
                                <!-- Top: Avatar + Teacher + Badge -->
                                <div class="attendance_kanban_card-top">
                                    <img t-if="record.teacher_id.raw_value"
                                         class="attendance_kanban_avatar"
                                         t-att-src="'/web/image/res.users/' + record.teacher_id.raw_value + '/image_128'"
                                         alt="Avatar"/>
                                    <div class="attendance_kanban_teacher-info">
                                        <div class="teacher-name" t-out="record.teacher_id.value || 'Sin profesor'"/>
                                        <div class="teacher-subject" t-if="record.subject_id.raw_value" t-out="record.subject_id.value"/>
                                    </div>
                                    <span class="attendance_kanban_status-badge"
                                          t-att-class="'badge-' + record.status.raw_value">
                                        <t t-if="record.status.raw_value === 'valid'">Asistió</t>
                                        <t t-if="record.status.raw_value === 'late'">Retardo</t>
                                        <t t-if="record.status.raw_value === 'absent'">Inasistencia</t>
                                        <t t-if="record.status.raw_value === 'outside'">Fuera del Radio</t>
                                        <t t-if="record.status.raw_value === 'manual'">Validado Manual</t>
                                        <t t-if="record.status.raw_value === 'invalid'">Inválido</t>
                                        <t t-if="record.status.raw_value === 'late_justified'">Retardo Justificado</t>
                                        <t t-if="record.status.raw_value === 'absent_justified'">Falta Justificada</t>
                                    </span>
                                </div>

                                <div class="attendance_kanban_separator"/>

                                <!-- Details -->
                                <div class="attendance_kanban_details">
                                    <!-- Classroom -->
                                    <div class="attendance_kanban_detail-row" t-if="record.classroom_id.raw_value">
                                        <i class="fa fa-building"/>
                                        <span class="detail-label">Aula</span>
                                        <span class="detail-value" t-out="record.classroom_id.value"/>
                                    </div>

                                    <!-- Time -->
                                    <div class="attendance_kanban_detail-row" t-if="record.check_in.raw_value">
                                        <i class="fa fa-clock"/>
                                        <span class="detail-label">Horario</span>
                                        <span class="detail-value">
                                            <t t-out="record.check_in.value"/>
                                            <t t-if="record.check_out.raw_value"> → <t t-out="record.check_out.value"/></t>
                                        </span>
                                    </div>

                                    <!-- Duration -->
                                    <div class="attendance_kanban_detail-row" t-if="record.duration.raw_value">
                                        <i class="fa fa-hourglass-half"/>
                                        <span class="detail-label">Duracion</span>
                                        <span class="detail-value">
                                            <t t-if="record.duration.raw_value &gt;= 1">
                                                <t t-out="Math.floor(record.duration.raw_value)"/>h
                                            </t>
                                            <t t-if="record.duration.raw_value % 1 > 0">
                                                <t t-out="Math.round((record.duration.raw_value % 1) * 60)"/>min
                                            </t>
                                        </span>
                                    </div>

                                    <!-- Distance -->
                                    <div class="attendance_kanban_detail-row" t-if="record.distance.raw_value">
                                        <i class="fa fa-map-marker-alt"/>
                                        <span class="detail-label">Distancia</span>
                                        <span class="detail-value" t-out="Math.round(record.distance.raw_value) + ' m'"/>
                                    </div>

                                    <!-- Substitution indicator -->
                                    <div class="attendance_kanban_detail-row" t-if="record.is_substitution.raw_value">
                                        <i class="fa fa-exchange-alt"/>
                                        <span class="detail-label">Tipo</span>
                                        <span class="detail-value attendance_kanban-substitution-badge">Sustitucion</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="attendance_kanban_card-footer">
                                <span>
                                    <i class="fa fa-map-pin me-1" title="Ubicacion"/>
                                    <t t-if="record.latitude.raw_value" t-out="'GPS: ' + record.latitude.raw_value + ', ' + record.longitude.raw_value"/>
                                    <t t-else="">Sin GPS</t>
                                </span>
                                <span>
                                    <i class="fa fa-signature me-1" title="Firma"/>
                                    <t t-if="record.signature.raw_value">Firmado</t>
                                    <t t-else="">Sin firma</t>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════ LIST VIEW (original) ═══════ -->
    <record id="view_attendance_log_tree" model="ir.ui.view">
        <field name="name">attendance.log.tree</field>
        <field name="model">attendance.log</field>
        <field name="arch" type="xml">
            <list create="false" class="o_unefa_view">
                <field name="teacher_id"/>
                <field name="classroom_id"/>
                <field name="subject_id"/>
                <field name="activity_type" widget="badge" optional="show"
                       decoration-info="activity_type == 'clase'"
                       decoration-warning="activity_type == 'asesoria'"
                       decoration-danger="activity_type == 'defensa'"/>
                <field name="is_substitution" optional="show"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration" widget="float_time" sum="Total Hours"/>
                <field name="distance" string="Dist (m)"/>
                <field name="method" widget="badge" optional="show"
                       decoration-info="method == 'qr'"
                       decoration-success="method == 'carnet'"
                       decoration-warning="method == 'kiosk'"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('valid', 'absent_justified')"
                       decoration-info="status in ('manual', 'late_justified')"
                       decoration-danger="status in ('outside', 'absent')"
                       decoration-warning="status == 'late'"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_log_calendar" model="ir.ui.view">
        <field name="name">attendance.log.calendar</field>
        <field name="model">attendance.log</field>
        <field name="arch" type="xml">
            <calendar string="Attendance Calendar" date_start="check_in" date_stop="check_out" color="teacher_id" mode="month">
                <field name="teacher_id" avatar_field="image_128"/>
                <field name="subject_id"/>
                <field name="classroom_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="view_attendance_log_form" model="ir.ui.view">
        <field name="name">attendance.log.form</field>
        <field name="model">attendance.log</field>
        <field name="arch" type="xml">
            <form create="false" class="o_unefa_view">
                <header>
                    <button name="action_validate_manually" string="Validate Manually" type="object" 
                            class="btn-primary" invisible="status == 'valid' or status == 'manual'"/>
                    <field name="status" widget="statusbar" statusbar_visible="valid,outside,late"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="teacher_id" string="Teacher"/>
                        <h1>
                            <field name="teacher_id" readonly="1" options="{'no_open': True}"/>
                        </h1>
                        <label for="subject_id" string="Subject"/>
                        <h2>
                            <field name="subject_id" readonly="1"/>
                        </h2>
                        <label for="classroom_id" string="Classroom"/>
                        <h3>
                            <field name="classroom_id" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Check-in/Out Details">
                            <field name="check_in" readonly="1"/>
                            <field name="check_out" readonly="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="distance" readonly="1"/>
                            <field name="activity_type"/>
                            <field name="is_substitution" readonly="1"/>
                            <field name="method" readonly="1"/>
                        </group>
                        <group string="Verification">
                            <field name="signature" widget="image" options="{'size': [200, 100]}" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Justification" name="justification">
                            <group>
                                <!-- readonly cuando es registro de contingencia (sellado e inalterable) -->
                                <field name="justification"
                                       placeholder="Reason for late/outside attendance..."
                                       readonly="method == 'manual'"/>
                            </group>
                            <div class="alert alert-warning" invisible="method != 'manual'">
                                <i class="fa fa-lock"/> Esta justificación fue registrada por contingencia manual y es inalterable.
                            </div>
                        </page>
                        <page string="Aval / Justificación" name="aval_justification">
                            <group>
                                <group string="Justificación de Coordinación">
                                    <field name="justification_aval"/>
                                    <field name="justification_reason"/>
                                </group>
                                <group string="Aprobación">
                                    <field name="justification_approver_id" readonly="1"/>
                                    <field name="justification_date" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="status"
                                 invisible="status in ('late_justified', 'absent_justified')">
                                <i class="fa fa-info-circle"/> Este registro no está justificado. Use la interfaz
                                «Justificaciones» para aprobar retardos o faltas en lote.
                            </div>
                        </page>
                        <page string="Evidence" name="evidence">
                            <group>
                                <field name="evidence" widget="image" options="{'size': [400, 400]}" nolabel="1"/>
                            </group>
                        </page>
                        <page string="GPS Data" name="technical">
                            <group>
                                <field name="latitude" readonly="1"/>
                                <field name="longitude" readonly="1"/>
                                <field name="device_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_attendance_log_graph" model="ir.ui.view">
        <field name="name">attendance.log.graph</field>
        <field name="model">attendance.log</field>
        <field name="arch" type="xml">
            <graph string="Attendance Analysis" type="bar">
                <field name="subject_id"/>
                <field name="status"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_attendance_log_pivot" model="ir.ui.view">
        <field name="name">attendance.log.pivot</field>
        <field name="model">attendance.log</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Analysis">
                <field name="check_in" type="row" interval="day"/>
                <field name="subject_id" type="row"/>
                <field name="teacher_id" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Acciones OWL — sustituyen las vistas nativas de Odoo -->
    <record id="action_attendance_log" model="ir.actions.client">
        <field name="name">Todos los Registros</field>
        <field name="tag">action_attendance_log</field>
    </record>

    <record id="action_attendance_log_my" model="ir.actions.client">
        <field name="name">Mis Registros</field>
        <field name="tag">action_attendance_log_my</field>
    </record>

    <record id="action_attendance_analysis" model="ir.actions.client">
        <field name="name">Análisis de Asistencia</field>
        <field name="tag">action_attendance_analysis</field>
    </record>

</odoo>
