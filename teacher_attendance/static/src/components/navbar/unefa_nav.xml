<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="teacher_attendance.UnefaNav">
        <!-- Solo renderizar para usuarios con acceso al módulo de asistencia -->
        <div t-if="state.hasAttendanceAccess" class="unefa-globalnav">

            <!-- Botón hamburguesa -->
            <button class="unefa-fab" t-if="!state.open" t-on-click="toggle" aria-label="Abrir menú">
                <i class="fa fa-bars"/>
            </button>

            <!-- Backdrop -->
            <div class="unefa-sidebar-backdrop"
                 t-att-class="{'is-open': state.open}"
                 t-on-click="close"/>

            <!-- Sidebar -->
            <aside class="unefa-sidebar" t-att-class="{'is-open': state.open}">
                <!-- Header -->
                <div class="unefa-sidebar-head">
                    <img src="/teacher_attendance/static/src/img/unefa_escudo.svg"
                         alt="UNEFA" class="unefa-sidebar-escudo"/>
                    <div class="unefa-sidebar-brand">
                        <span class="unefa-sidebar-siglas">UNEFA</span>
                        <span class="unefa-sidebar-sub">Asistencia Docente</span>
                    </div>
                    <button class="unefa-sidebar-close" t-on-click="close" aria-label="Cerrar">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <!-- Usuario — clickeable abre Mi Perfil -->
                <button class="unefa-sidebar-user unefa-sidebar-user-btn" t-on-click="navigateToProfile"
                        title="Ver mi perfil">
                    <div class="unefa-sidebar-avatar" t-out="state.userInitial"/>
                    <div class="unefa-sidebar-user-meta">
                        <span class="unefa-sidebar-username" t-out="state.userName"/>
                        <span class="unefa-sidebar-userrole" t-out="userRoleLabel"/>
                    </div>
                    <i class="fa fa-pencil unefa-profile-hint"/>
                </button>

                <!-- Navegación -->
                <nav class="unefa-sidebar-nav">
                    <t t-foreach="navSections" t-as="section" t-key="section.id">
                        <div class="nav-section">
                            <button class="nav-section-head" t-on-click="() => this.toggleSection(section.id)">
                                <div class="nav-section-label">
                                    <i class="fa" t-att-class="section.icon"/>
                                    <span t-out="section.label"/>
                                </div>
                                <i class="fa fa-chevron-down nav-chevron"
                                   t-att-class="{'open': isSectionExpanded(section.id)}"/>
                            </button>
                            <div class="nav-section-body" t-att-class="{'open': isSectionExpanded(section.id)}">
                                <div>
                                    <t t-foreach="section.items" t-as="item" t-key="item.action">
                                        <button class="nav-link"
                                                t-on-click="() => this.navigateTo(item)">
                                            <i class="fa" t-att-class="item.icon"/>
                                            <span t-out="item.label"/>
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </nav>

                <!-- Footer -->
                <div class="unefa-sidebar-foot">
                    <button class="nav-link nav-link-profile" t-on-click="navigateToProfile">
                        <i class="fa fa-user-circle"/>
                        <span>Mi Perfil</span>
                        <span class="unefa-profile-sub">Contraseña · Dispositivos</span>
                    </button>
                    <button class="nav-link nav-link-logout" t-on-click="logout">
                        <i class="fa fa-power-off"/>
                        <span>Cerrar sesión</span>
                    </button>
                </div>
            </aside>
        </div>
    </t>
</templates>