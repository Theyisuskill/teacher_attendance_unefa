<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="teacher_attendance.ClassroomManager">
        <div class="o_classroom_manager">

            <!-- Header institucional -->
            <div class="unefa-page-header">
                <div class="unefa-flag-top"/>
                <div class="unefa-page-header-main">
                    <div class="unefa-page-header-left">
                        <button class="unefa-btn-back" t-on-click="goBack">
                            <i class="fa fa-arrow-left"/>
                        </button>
                        <div class="unefa-page-header-info">
                            <h1 class="unefa-page-title">
                                <i class="fa fa-building"/>
                                Gestión de Aulas
                            </h1>
                            <p class="unefa-page-subtitle">Administrar aulas y salones de clase</p>
                        </div>
                    </div>
                    <button class="unefa-btn-primary" t-on-click="showCreateForm"
                            t-if="state.currentView === 'list'">
                        <i class="fa fa-plus"/>
                        Nueva Aula
                    </button>
                </div>
            </div>

            <div class="unefa-page-content">

                <!-- Vista de lista -->
                <t t-if="state.currentView === 'list'">
                    <!-- Barra de búsqueda -->
                    <div class="unefa-search-bar">
                        <div class="unefa-search-input-wrap">
                            <i class="fa fa-search"/>
                            <input type="text"
                                   class="unefa-search-input"
                                   placeholder="Buscar por nombre o código..."
                                   t-model="state.searchQuery"
                                   t-on-input="onSearchInput"/>
                        </div>
                        <div class="unefa-search-count">
                            <t t-out="state.filteredClassrooms.length"/> aulas
                        </div>
                    </div>

                    <!-- Loading -->
                    <div t-if="state.isLoading" class="unefa-loading">
                        <i class="fa fa-spinner fa-spin fa-2x"/>
                        <p>Cargando aulas...</p>
                    </div>

                    <!-- Lista de aulas -->
                    <div t-elif="state.filteredClassrooms.length === 0" class="unefa-empty-state">
                        <i class="fa fa-building fa-3x"/>
                        <h4>No se encontraron aulas</h4>
                        <p>Intente con otra búsqueda o cree una nueva aula</p>
                    </div>

                    <div t-else="" class="unefa-classroom-grid">
                        <t t-foreach="state.filteredClassrooms" t-as="cr" t-key="cr.id">
                            <div class="unefa-classroom-card">
                                <div class="unefa-classroom-card-header">
                                    <div class="unefa-classroom-icon">
                                        <i class="fa fa-building-o"/>
                                    </div>
                                    <div class="unefa-classroom-card-info">
                                        <h3 class="unefa-classroom-name" t-out="cr.name"/>
                                        <span class="unefa-classroom-code" t-out="cr.code"/>
                                    </div>
                                    <div class="unefa-classroom-qr" t-if="cr.secret_key">
                                        <i class="fa fa-qrcode"/>
                                    </div>
                                </div>

                                <div class="unefa-classroom-card-body">
                                    <div class="unefa-classroom-detail">
                                        <i class="fa fa-map-marker"/>
                                        <span t-if="cr.latitude">
                                            GPS: <t t-out="cr.latitude.toFixed(5)"/>, <t t-out="cr.longitude.toFixed(5)"/>
                                        </span>
                                        <span t-else="">Sin ubicación GPS</span>
                                    </div>
                                    <div class="unefa-classroom-detail">
                                        <i class="fa fa-arrows-alt"/>
                                        <span>Radio: <t t-out="cr.radius"/> metros</span>
                                    </div>
                                    <div class="unefa-classroom-detail" t-if="cr.check_schedule">
                                        <i class="fa fa-clock"/>
                                        <span>Horarios activados (tolerancia: <t t-out="cr.tolerance_margin"/> min)</span>
                                    </div>
                                </div>

                                <div class="unefa-classroom-card-actions">
                                    <button class="unefa-btn-icon btn-edit"
                                            t-on-click="() => this.showEditForm(cr.id)"
                                            title="Editar">
                                        <i class="fa fa-pencil"/>
                                    </button>
                                    <button class="unefa-btn-icon btn-download"
                                            t-on-click="() => this.downloadQR(cr.id)"
                                            title="Descargar QR">
                                        <i class="fa fa-download"/>
                                    </button>
                                    <button class="unefa-btn-icon btn-delete"
                                            t-on-click="() => this.deleteClassroom(cr.id)"
                                            title="Eliminar">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Vista de formulario -->
                <t t-if="state.currentView === 'form'">
                    <div class="unefa-form-container">
                        <div class="unefa-form-header">
                            <h2>
                                <i class="fa" t-att-class="state.editingClassroom ? 'fa-building' : 'fa-plus-circle'"/>
                                <t t-if="state.editingClassroom">Editar Aula</t>
                                <t t-else="">Nueva Aula</t>
                            </h2>
                        </div>

                        <div class="unefa-form-body">
                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">
                                    <i class="fa fa-id-card"/>
                                    Información del Aula
                                </h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Nombre del aula *</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="Ej: Laboratorio de Ciencias"
                                               t-model="state.formData.name"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Código *</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="Ej: LAB-01"
                                               t-model="state.formData.code"/>
                                    </div>
                                </div>
                            </div>

                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">
                                    <i class="fa fa-map-marker"/>
                                    Ubicación GPS
                                </h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Latitud</label>
                                        <input type="number"
                                               class="unefa-input"
                                               step="0.00001"
                                               placeholder="0.00000"
                                               t-model="state.formData.latitude"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Longitud</label>
                                        <input type="number"
                                               class="unefa-input"
                                               step="0.00001"
                                               placeholder="0.00000"
                                               t-model="state.formData.longitude"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Radio de validación (metros)</label>
                                        <input type="number"
                                               class="unefa-input"
                                               min="5"
                                               max="500"
                                               t-model="state.formData.radius"/>
                                    </div>
                                </div>
                            </div>

                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">
                                    <i class="fa fa-clock"/>
                                    Horarios
                                </h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <div class="unefa-toggle-wrap">
                                            <label class="unefa-toggle">
                                                <input type="checkbox"
                                                       t-model="state.formData.check_schedule"/>
                                                <span class="unefa-toggle-slider"/>
                                            </label>
                                            <span class="unefa-toggle-label">Validar horarios</span>
                                        </div>
                                    </div>
                                    <div class="unefa-form-group" t-if="state.formData.check_schedule">
                                        <label class="unefa-label">Tolerancia (minutos)</label>
                                        <input type="number"
                                               class="unefa-input"
                                               min="0"
                                               max="60"
                                               t-model="state.formData.tolerance_margin"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="unefa-form-footer">
                            <button class="unefa-btn-secondary" t-on-click="cancelForm">
                                <i class="fa fa-times"/>
                                Cancelar
                            </button>
                            <button class="unefa-btn-primary" t-on-click="saveClassroom">
                                <i class="fa fa-check"/>
                                <t t-if="state.editingClassroom">Guardar Cambios</t>
                                <t t-else="">Crear Aula</t>
                            </button>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Footer -->
            <div class="unefa-page-footer">
                <div class="unefa-flag-stripe"/>
                <span>UNEFA · Sistema de Asistencia Docente</span>
            </div>
        </div>
    </t>
</templates>
