<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="teacher_attendance.AttendanceHistory">
        <div class="o_attendance_history w-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0 fw-bold" style="color: #5273A8;">
                    <i class="fa fa-history me-2"/>Actividad Reciente
                </h5>
                <span class="badge rounded-pill" style="background: #6E8FC7;">
                    <t t-out="state.logs.length"/> registros
                </span>
            </div>
            <div class="list-group list-group-flush">
                <t t-foreach="state.logs" t-as="log" t-key="log.id">
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-3 history-item">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                  t-att-class="{
                                      'bg-success bg-opacity-10': log.status === 'valid',
                                      'bg-danger bg-opacity-10': log.status === 'outside',
                                      'bg-warning bg-opacity-10': log.status === 'late',
                                      'bg-secondary bg-opacity-10': log.status === 'invalid' || log.status === 'manual'
                                  }"
                                  style="width: 40px; height: 40px; min-width: 40px;">
                                <i t-att-class="{
                                    'fa fa-check text-success': log.status === 'valid',
                                    'fa fa-map-marker text-danger': log.status === 'outside',
                                    'fa fa-clock text-warning': log.status === 'late',
                                    'fa fa-question text-secondary': log.status === 'invalid' || log.status === 'manual'
                                }"/>
                            </div>
                            <div class="text-start">
                                <h6 class="mb-0 fw-semibold"><t t-esc="log.classroom_id[1]"/></h6>
                                <small class="text-muted">
                                    <i class="fa fa-calendar me-1"/>
                                    <t t-esc="log.check_in"/>
                                </small>
                                <t t-if="log.distance">
                                    <small class="text-muted ms-2">
                                        <i class="fa fa-location-arrow me-1"/>
                                        <t t-esc="this.getRoundedDistance(log.distance)"/>m
                                    </small>
                                </t>
                            </div>
                        </div>
                        <span t-att-class="{
                                'badge bg-success': log.status === 'valid',
                                'badge bg-danger': log.status === 'outside',
                                'badge bg-warning text-dark': log.status === 'late',
                                'badge bg-info': log.status === 'manual',
                                'badge bg-secondary': log.status === 'invalid'
                              }" class="rounded-pill">
                            <t t-if="log.status === 'valid'">Valido</t>
                            <t t-if="log.status === 'outside'">Fuera</t>
                            <t t-if="log.status === 'late'">Tardanza</t>
                            <t t-if="log.status === 'manual'">Manual</t>
                            <t t-if="log.status === 'invalid'">Invalido</t>
                        </span>
                    </div>
                </t>
                <t t-if="state.logs.length === 0">
                    <div class="list-group-item text-center text-muted py-4 border-0">
                        <i class="fa fa-inbox fa-2x mb-2 opacity-25"/>
                        <p class="mb-0">Sin actividad reciente</p>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
