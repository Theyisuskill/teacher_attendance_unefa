<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="teacher_attendance.AttendanceKiosk" owl="1">
        <style>
            .o_kiosk_bg {
                background: linear-gradient(135deg, #6E8FC7 0%, #43618F 50%, #6E8FC7 100%);
                height: 100vh;
                width: 100vw;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                font-family: 'Inter', sans-serif;
                position: relative;
                overflow: hidden;
            }
            .o_kiosk_bg::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 6px;
                background: linear-gradient(90deg, #F1D88B 33%, #6E8FC7 33%, #6E8FC7 66%, #DE979D 66%);
            }
            .kiosk_card {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border-radius: 30px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.3);
                width: 100%;
                max-width: 480px;
                padding: 40px;
                text-align: center;
            }
            .pin_dot {
                width: 20px;
                height: 20px;
                border-radius: 50%;
                border: 2px solid #6E8FC7;
                transition: all 0.2s ease;
            }
            .pin_dot.filled {
                background: #6E8FC7;
                transform: scale(1.2);
            }
            .num_btn {
                width: 80px;
                height: 80px;
                border-radius: 50% !important;
                font-size: 1.8rem !important;
                font-weight: 600 !important;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 10px auto;
                border: 2px solid #f0f0f0 !important;
                background: white !important;
                color: #444 !important;
                transition: all 0.1s ease !important;
            }
            .num_btn:active {
                background: #6E8FC7 !important;
                color: white !important;
                transform: scale(0.9);
            }
            .num_btn.action {
                background: #f8f9fa !important;
                border: none !important;
            }
            .kiosk_select {
                border: 2px solid #eee;
                border-radius: 15px;
                padding: 15px;
                font-size: 1.2rem;
                margin-bottom: 30px;
                background-color: white;
            }
            .success_overlay {
                background: linear-gradient(135deg, #28a745, #20c997);
                color: white;
                border-radius: 30px;
                position: absolute;
                top: 0; left: 0; right: 0; bottom: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 10;
                animation: fadeIn 0.3s ease;
            }
            .error_overlay {
                background: linear-gradient(135deg, #DE979D, #C57680);
                color: white;
                border-radius: 30px;
                position: absolute;
                top: 0; left: 0; right: 0; bottom: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 10;
                animation: fadeIn 0.3s ease;
            }
            @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
            .kiosk_flag-stripe {
                height: 4px;
                background: linear-gradient(90deg, #F1D88B 33%, #6E8FC7 33%, #6E8FC7 66%, #DE979D 66%);
                border-radius: 2px;
                width: 200px;
                margin: 0 auto;
            }
        </style>

        <div class="o_kiosk_bg">
            <div class="text-center text-white mb-4">
                <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 100px; height: 100px;">
                    <img src="/teacher_attendance/static/src/img/unefa_escudo.svg" alt="UNEFA" style="width: 80px; height: 80px; object-fit: contain;"/>
                </div>
                <h1 class="display-5 fw-bold">UNEFA</h1>
                <p class="opacity-75 fs-5">Asistencia en Kiosco</p>
                <div class="kiosk_flag-stripe mt-2"/>
            </div>

            <div class="kiosk_card position-relative">
                <t t-if="state.status === 'success'">
                    <div class="success_overlay">
                        <i class="fa fa-check-circle fa-5x mb-3"/>
                        <h2>Registro Exitoso!</h2>
                        <p class="fs-5">Que tenga buena clase</p>
                    </div>
                </t>
                <t t-if="state.status === 'error'">
                    <div class="error_overlay">
                        <i class="fa fa-times-circle fa-5x mb-3"/>
                        <h2>Error</h2>
                        <p class="fs-5">PIN invalido</p>
                    </div>
                </t>

                <!-- Classroom Select -->
                <div class="mb-4">
                    <label class="text-muted small fw-bold text-uppercase mb-2 d-block">Aula Actual</label>
                    <select class="form-select kiosk_select shadow-sm" t-model="state.selectedClassroom">
                        <option value="null">-- Seleccione el aula --</option>
                        <t t-foreach="state.classrooms" t-as="aula" t-key="aula.id">
                            <option t-att-value="aula.id"><t t-esc="aula.name"/></option>
                        </t>
                    </select>
                </div>

                <!-- PIN Visual -->
                <div class="d-flex justify-content-center gap-4 mb-5">
                    <t t-foreach="[0,1,2,3]" t-as="i" t-key="i">
                        <div class="pin_dot" t-att-class="{'filled': state.pin.length > i}"/>
                    </t>
                </div>

                <!-- Keypad -->
                <div class="row g-0">
                    <t t-foreach="[1,2,3,4,5,6,7,8,9]" t-as="n" t-key="n">
                        <div class="col-4">
                            <button class="btn num_btn shadow-sm" t-on-click="() => this.onNumberClick(n)">
                                <t t-esc="n"/>
                            </button>
                        </div>
                    </t>
                    <div class="col-4">
                        <button class="btn num_btn action text-danger shadow-sm" t-on-click="clearPin">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div class="col-4">
                        <button class="btn num_btn shadow-sm" t-on-click="() => this.onNumberClick(0)">0</button>
                    </div>
                    <div class="col-4 d-flex align-items-center justify-content-center">
                        <t t-if="state.status === 'loading'">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x" style="color: #6E8FC7;"/>
                        </t>
                        <t t-else="">
                            <i class="fa fa-lock fa-2x text-muted opacity-25"/>
                        </t>
                    </div>
                </div>
            </div>

            <div class="mt-5 text-white-50 text-center">
                <small>UNEFA - Sistema de Asistencia Docente</small>
                <div class="kiosk_flag-stripe mt-2"/>
            </div>
        </div>
    </t>
</templates>
