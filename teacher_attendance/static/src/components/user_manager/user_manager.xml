<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="teacher_attendance.UserManager">
        <div class="o_user_manager">

            <!-- Header institucional -->
            <div class="unefa-page-header">
                <div class="unefa-flag-top"/>
                <div class="unefa-page-header-main">
                    <div class="unefa-page-header-left">
                        <button class="unefa-btn-back" t-on-click="goBack">
                            <i class="fa fa-arrow-left"/>
                        </button>
                        <div class="unefa-page-header-info">
                            <h1 class="unefa-page-title">
                                <i class="fa fa-users-cog"/>
                                Gestión de Usuarios
                            </h1>
                            <p class="unefa-page-subtitle">Administrar usuarios del sistema de asistencia</p>
                        </div>
                    </div>
                    <button class="unefa-btn-primary" t-on-click="showCreateForm"
                            t-if="state.currentView === 'list'">
                        <i class="fa fa-plus"/>
                        Nuevo Usuario
                    </button>
                </div>
            </div>

            <div class="unefa-page-content">

                <!-- Vista de lista -->
                <t t-if="state.currentView === 'list'">
                    <!-- Barra de búsqueda -->
                    <div class="unefa-search-bar">
                        <div class="unefa-search-input-wrap">
                            <i class="fa fa-search"/>
                            <input type="text"
                                   class="unefa-search-input"
                                   placeholder="Buscar por nombre, login o email..."
                                   t-model="state.searchQuery"
                                   t-on-input="onSearchInput"/>
                        </div>
                        <div class="unefa-search-count">
                            <t t-out="state.filteredUsers.length"/> usuarios
                        </div>
                    </div>

                    <!-- Loading -->
                    <div t-if="state.isLoading" class="unefa-loading">
                        <i class="fa fa-spinner fa-spin fa-2x"/>
                        <p>Cargando usuarios...</p>
                    </div>

                    <!-- Lista de usuarios -->
                    <div t-elif="state.filteredUsers.length === 0" class="unefa-empty-state">
                        <i class="fa fa-users fa-3x"/>
                        <h4>No se encontraron usuarios</h4>
                        <p>Intente con otra búsqueda o cree un nuevo usuario</p>
                    </div>

                    <div t-else="" class="unefa-user-grid">
                        <t t-foreach="state.filteredUsers" t-as="u" t-key="u.id">
                            <div class="unefa-user-card" t-att-class="{'is-inactive': !u.active}">
                                <div class="unefa-user-card-header">
                                    <div class="unefa-user-avatar">
                                        <i class="fa fa-user"/>
                                    </div>
                                    <div class="unefa-user-card-info">
                                        <h3 class="unefa-user-name" t-out="u.name"/>
                                        <span class="unefa-user-login" t-out="'@' + u.login"/>
                                    </div>
                                    <span class="unefa-user-status"
                                          t-att-class="u.active ? 'status-active' : 'status-inactive'">
                                        <t t-if="u.active">Activo</t>
                                        <t t-else="">Inactivo</t>
                                    </span>
                                </div>

                                <div class="unefa-user-card-body">
                                    <div class="unefa-user-detail" t-if="u.email">
                                        <i class="fa fa-envelope"/>
                                        <span t-out="u.email"/>
                                    </div>
                                    <div class="unefa-user-detail" t-if="u.phone">
                                        <i class="fa fa-phone"/>
                                        <span t-out="u.phone"/>
                                    </div>
                                    <div class="unefa-user-detail" t-if="u.attendance_pin">
                                        <i class="fa fa-key"/>
                                        <span>PIN configurado</span>
                                    </div>
                                </div>

                                <div class="unefa-user-card-actions">
                                    <button class="unefa-btn-icon btn-edit"
                                            t-on-click="() => this.showEditForm(u.id)"
                                            title="Editar">
                                        <i class="fa fa-pencil-alt"/>
                                    </button>
                                    <button class="unefa-btn-icon btn-toggle"
                                            t-on-click="() => this.toggleUserActive(u.id)"
                                            t-att-title="u.active ? 'Desactivar' : 'Activar'">
                                        <i t-att-class="u.active ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                                    </button>
                                    <button class="unefa-btn-icon btn-delete"
                                            t-on-click="() => this.deleteUser(u.id)"
                                            title="Eliminar">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Vista de formulario -->
                <t t-if="state.currentView === 'form'">
                    <div class="unefa-form-container">
                        <div class="unefa-form-header">
                            <h2>
                                <i class="fa" t-att-class="state.editingUser ? 'fa-user-edit' : 'fa-user-plus'"/>
                                <t t-if="state.editingUser">Editar Usuario</t>
                                <t t-else="">Nuevo Usuario</t>
                            </h2>
                        </div>

                        <div class="unefa-form-body">
                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">
                                    <i class="fa fa-id-card"/>
                                    Información Personal
                                </h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Nombre completo *</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="Nombre y apellido"
                                               t-model="state.formData.name"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Login (usuario) *</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="nombre.usuario"
                                               t-model="state.formData.login"
                                               t-att-disabled="!!state.editingUser"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Email *</label>
                                        <input type="email"
                                               class="unefa-input"
                                               placeholder="correo@unefa.edu.ve"
                                               t-model="state.formData.email"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Teléfono</label>
                                        <input type="tel"
                                               class="unefa-input"
                                               placeholder="+58 000-000-0000"
                                               t-model="state.formData.phone"/>
                                    </div>
                                </div>
                            </div>

                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">
                                    <i class="fa fa-shield-alt"/>
                                    Acceso al Sistema
                                </h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">PIN de Asistencia (4 dígitos)</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="0000"
                                               maxlength="4"
                                               t-model="state.formData.attendance_pin"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Estado</label>
                                        <div class="unefa-toggle-wrap">
                                            <label class="unefa-toggle">
                                                <input type="checkbox"
                                                       t-model="state.formData.active"/>
                                                <span class="unefa-toggle-slider"/>
                                            </label>
                                            <span class="unefa-toggle-label"
                                                  t-out="state.formData.active ? 'Activo' : 'Inactivo'"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="unefa-form-footer">
                            <button class="unefa-btn-secondary" t-on-click="cancelForm">
                                <i class="fa fa-times"/>
                                Cancelar
                            </button>
                            <button class="unefa-btn-primary" t-on-click="saveUser">
                                <i class="fa fa-check"/>
                                <t t-if="state.editingUser">Guardar Cambios</t>
                                <t t-else="">Crear Usuario</t>
                            </button>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Footer -->
            <div class="unefa-page-footer">
                <div class="unefa-flag-stripe"/>
                <span>UNEFA · Sistema de Asistencia Docente</span>
            </div>
        </div>
    </t>
</templates>
