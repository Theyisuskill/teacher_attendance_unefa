<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="teacher_attendance.UserManager">
        <div class="o_user_manager">

            <!-- Header institucional -->
            <div class="unefa-page-header">
                <div class="unefa-flag-top"/>
                <div class="unefa-page-header-main">
                    <div class="unefa-page-header-left">
                        <button class="unefa-btn-back" t-on-click="goBack">
                            <i class="fa fa-arrow-left"/>
                        </button>
                        <div class="unefa-page-header-info">
                            <h1 class="unefa-page-title">
                                <i class="fa fa-users"/>
                                Gestión de Usuarios
                            </h1>
                            <p class="unefa-page-subtitle">Administrar usuarios del sistema de asistencia</p>
                        </div>
                    </div>
                    <button class="unefa-btn-primary" t-on-click="showCreateForm"
                            t-if="state.currentView === 'list'">
                        <i class="fa fa-plus"/>
                        Nuevo Usuario
                    </button>
                </div>
            </div>

            <div class="unefa-page-content">

                <!-- Vista de lista -->
                <t t-if="state.currentView === 'list'">
                    <div class="unefa-search-bar">
                        <div class="unefa-search-input-wrap">
                            <i class="fa fa-search"/>
                            <input type="text"
                                   class="unefa-search-input"
                                   placeholder="Buscar por nombre, login o cédula..."
                                   t-model="state.searchQuery"
                                   t-on-input="onSearchInput"/>
                        </div>
                        <select class="unefa-input sch-select"
                                t-model="state.filterRole"
                                t-on-change="onFilterRole">
                            <option value="">Todos los roles</option>
                            <option value="admin">Administrador</option>
                            <option value="coordinator">Coordinador</option>
                            <option value="teacher">Docente</option>
                            <option value="none">Sin rol</option>
                        </select>
                        <select class="unefa-input sch-select"
                                t-model="state.filterCategory"
                                t-on-change="onFilterCategory">
                            <option value="">Categoría</option>
                            <option value="instructor">Instructor</option>
                            <option value="asistente">Asistente</option>
                            <option value="agregado">Agregado</option>
                            <option value="asociado">Asociado</option>
                            <option value="titular">Titular</option>
                        </select>
                        <select class="unefa-input sch-select"
                                t-model="state.filterDedication"
                                t-on-change="onFilterDedication">
                            <option value="">Dedicación</option>
                            <option value="completo">T. Completo</option>
                            <option value="medio">Medio Tiempo</option>
                            <option value="variable">T. Variable</option>
                        </select>
                        <div class="unefa-search-count">
                            <t t-out="state.filteredUsers.length"/> usuarios
                        </div>
                    </div>

                    <!-- Loading -->
                    <div t-if="state.isLoading" class="unefa-loading">
                        <i class="fa fa-spinner fa-spin fa-2x"/>
                        <p>Cargando usuarios...</p>
                    </div>

                    <!-- Lista de usuarios -->
                    <div t-elif="state.filteredUsers.length === 0" class="unefa-empty-state">
                        <i class="fa fa-users fa-3x"/>
                        <h4>No se encontraron usuarios</h4>
                        <p>Intente con otra búsqueda o cree un nuevo usuario</p>
                    </div>

                    <div t-else="" class="unefa-user-grid">
                        <t t-foreach="state.filteredUsers" t-as="u" t-key="u.id">
                            <div class="unefa-user-card"
                                 t-att-class="{'is-inactive': !u.active, 'is-locked': isLocked(u)}">
                                <div class="unefa-user-card-header">
                                    <div class="unefa-user-avatar">
                                        <t t-out="u.name ? u.name.charAt(0).toUpperCase() : '?'"/>
                                    </div>
                                    <div class="unefa-user-card-info">
                                        <h3 class="unefa-user-name" t-out="u.name"/>
                                        <span class="unefa-user-login" t-out="'@' + u.login"/>
                                        <span class="unefa-user-vat" t-if="u.vat" t-out="u.vat"/>
                                        <div class="unefa-teacher-meta" t-if="u.teacher_category or u.teacher_dedication">
                                            <span class="unefa-cat-badge" t-if="u.teacher_category"
                                                  t-out="categoryLabels[u.teacher_category]"/>
                                            <span class="unefa-ded-badge" t-if="u.teacher_dedication"
                                                  t-out="dedicationLabels[u.teacher_dedication]"/>
                                        </div>
                                    </div>
                                    <div class="unefa-user-badges">
                                        <span class="unefa-role-badge"
                                              t-att-class="'role-' + (u.attendance_role || 'none')">
                                            <t t-out="roleLabels[u.attendance_role] || 'Sin rol'"/>
                                        </span>
                                        <span class="unefa-user-status"
                                              t-att-class="u.active ? 'status-active' : 'status-inactive'">
                                            <t t-if="u.active">Activo</t>
                                            <t t-else="">Inactivo</t>
                                        </span>
                                    </div>
                                </div>

                                <div class="unefa-user-card-actions">
                                    <!-- Indicador de bloqueo -->
                                    <span class="unefa-lock-chip" t-if="isLocked(u)"
                                          t-att-title="'Bloqueado por ' + u.failed_login_attempts + ' intentos fallidos'">
                                        <i class="fa fa-lock"/> Bloqueado
                                        <span t-if="lockRemainingText(u)"
                                              t-out="'(' + lockRemainingText(u) + ')'"/>
                                    </span>
                                    <button class="unefa-btn-icon btn-unlock"
                                            t-if="isLocked(u)"
                                            t-on-click="() => this.unlockUser(u.id)"
                                            title="Desbloquear cuenta">
                                        <i class="fa fa-unlock"/>
                                    </button>
                                    <!-- Dispositivo vinculado -->
                                    <span class="unefa-device-chip" t-if="u.attendance_device_id"
                                          title="Tiene un dispositivo vinculado para registrar asistencia">
                                        <i class="fa fa-mobile"/> Dispositivo vinculado
                                    </span>
                                    <button class="unefa-btn-icon btn-toggle"
                                            t-if="u.attendance_device_id"
                                            t-on-click="() => this.releaseDevice(u.id)"
                                            title="Liberar dispositivo vinculado">
                                        <i class="fa fa-unlink"/>
                                    </button>
                                    <button class="unefa-btn-icon btn-edit"
                                            t-on-click="() => this.showEditForm(u.id)"
                                            title="Editar">
                                        <i class="fa fa-pencil"/>
                                    </button>
                                    <button class="unefa-btn-icon btn-toggle"
                                            t-on-click="() => this.toggleUserActive(u.id)"
                                            t-att-title="u.active ? 'Desactivar' : 'Activar'">
                                        <i t-att-class="u.active ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                                    </button>
                                    <button class="unefa-btn-icon btn-delete"
                                            t-on-click="() => this.deleteUser(u.id)"
                                            title="Eliminar">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Vista de formulario -->
                <t t-if="state.currentView === 'form'">
                    <div class="unefa-form-container">
                        <div class="unefa-form-header">
                            <h2>
                                <i class="fa" t-att-class="state.editingUser ? 'fa-pencil' : 'fa-user-plus'"/>
                                <t t-if="state.editingUser">Editar Usuario</t>
                                <t t-else="">Nuevo Usuario</t>
                            </h2>
                        </div>

                        <div class="unefa-form-body">
                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">Información Personal</h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Nombre completo *</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="Nombre y apellido"
                                               t-model="state.formData.name"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Cédula / RIF</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="V-12345678"
                                               t-model="state.formData.vat"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Teléfono</label>
                                        <input type="tel"
                                               class="unefa-input"
                                               placeholder="+58 412-1234567"
                                               t-model="state.formData.phone"/>
                                    </div>
                                    <div class="unefa-form-group" t-if="!state.editingUser">
                                        <label class="unefa-label">Email *</label>
                                        <input type="email"
                                               class="unefa-input"
                                               placeholder="correo@unefa.edu.ve"
                                               t-model="state.formData.email"/>
                                    </div>
                                    <div class="unefa-form-group" t-if="state.editingUser">
                                        <label class="unefa-label">Email</label>
                                        <input type="email"
                                               class="unefa-input"
                                               placeholder="correo@unefa.edu.ve"
                                               t-model="state.formData.email"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Categoría y Dedicación (solo para roles docentes) -->
                            <div class="unefa-form-section"
                                 t-if="state.formData.attendance_role === 'teacher' or state.formData.attendance_role === 'coordinator'">
                                <h3 class="unefa-form-section-title"><i class="fa fa-graduation-cap"/> Perfil Académico</h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Categoría Docente</label>
                                        <select class="unefa-input" t-model="state.formData.teacher_category">
                                            <option value="">— Seleccione —</option>
                                            <option value="instructor">Instructor</option>
                                            <option value="asistente">Asistente</option>
                                            <option value="agregado">Agregado</option>
                                            <option value="asociado">Asociado</option>
                                            <option value="titular">Titular</option>
                                        </select>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Dedicación</label>
                                        <select class="unefa-input" t-model="state.formData.teacher_dedication">
                                            <option value="">— Seleccione —</option>
                                            <option value="completo">Tiempo Completo</option>
                                            <option value="medio">Medio Tiempo</option>
                                            <option value="variable">Tiempo Variable</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">Acceso y Rol</h3>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group" t-if="!state.editingUser">
                                        <label class="unefa-label">Login (usuario) *</label>
                                        <input type="text"
                                               class="unefa-input"
                                               placeholder="nombre.usuario"
                                               t-model="state.formData.login"/>
                                    </div>
                                    <div class="unefa-form-group" t-if="state.editingUser">
                                        <label class="unefa-label">Login</label>
                                        <input type="text"
                                               class="unefa-input"
                                               t-att-value="state.formData.login"
                                               disabled=""/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Rol de Asistencia</label>
                                        <select class="unefa-input" t-model="state.formData.attendance_role">
                                            <option value="none">Sin rol</option>
                                            <option value="admin">Administrador</option>
                                            <option value="teacher">Docente</option>
                                            <option value="coordinator">Coordinador</option>
                                        </select>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">PIN Kiosko (4 dígitos)</label>
                                        <input type="password"
                                               class="unefa-input"
                                               placeholder="****"
                                               maxlength="4"
                                               t-model="state.formData.attendance_pin"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Estado</label>
                                        <div class="unefa-toggle-wrap">
                                            <label class="unefa-toggle">
                                                <input type="checkbox"
                                                       t-model="state.formData.active"/>
                                                <span class="unefa-toggle-slider"/>
                                            </label>
                                            <span class="unefa-toggle-label"
                                                  t-out="state.formData.active ? 'Activo' : 'Inactivo'"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="unefa-form-section">
                                <h3 class="unefa-form-section-title">
                                    <t t-if="state.editingUser">Cambiar Contraseña</t>
                                    <t t-else="">Contraseña *</t>
                                </h3>
                                <p class="unefa-form-section-help" t-if="state.editingUser">Dejar en blanco si no desea cambiar la contraseña</p>
                                <p class="unefa-form-section-help" t-else="">Obligatoria — el usuario la necesita para iniciar sesión</p>
                                <div class="unefa-form-grid">
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">
                                            <t t-if="state.editingUser">Nueva contraseña</t>
                                            <t t-else="">Contraseña</t>
                                        </label>
                                        <input type="password"
                                               class="unefa-input"
                                               placeholder="••••••••"
                                               t-model="state.formData.new_password"/>
                                    </div>
                                    <div class="unefa-form-group">
                                        <label class="unefa-label">Confirmar contraseña</label>
                                        <input type="password"
                                               class="unefa-input"
                                               placeholder="••••••••"
                                               t-model="state.formData.confirm_password"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="unefa-form-footer">
                            <button class="unefa-btn-secondary" t-on-click="cancelForm">
                                <i class="fa fa-times"/>
                                Cancelar
                            </button>
                            <button class="unefa-btn-primary" t-on-click="saveUser">
                                <i class="fa fa-check"/>
                                <t t-if="state.editingUser">Guardar Cambios</t>
                                <t t-else="">Crear Usuario</t>
                            </button>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Footer -->
            <div class="unefa-page-footer">
                <div class="unefa-flag-stripe"/>
                <span>UNEFA · Sistema de Asistencia Docente</span>
            </div>
        </div>
    </t>
</templates>