<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Verificación diaria de cumplimiento de carga horaria docente.
         Envía alerta consolidada a coordinadores con los docentes bajo mínimo. -->
    <record id="cron_check_teacher_load" model="ir.cron">
        <field name="name">UNEFA: Verificación Diaria de Carga Horaria Docente</field>
        <field name="model_id" ref="model_attendance_schedule"/>
        <field name="state">code</field>
        <field name="code">model.check_teacher_load_compliance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <!-- Generación automática de Inasistencias cada 30 minutos -->
    <record id="cron_generate_absences" model="ir.cron">
        <field name="name">UNEFA: Generación de Inasistencias Automáticas</field>
        <field name="model_id" ref="model_attendance_log"/>
        <field name="state">code</field>
        <field name="code">model.generate_absence_records()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
